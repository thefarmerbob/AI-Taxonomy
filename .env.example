# Copy this file to `.env` and paste your real key in.
#   cp .env.example .env
#
# Get a key at https://console.anthropic.com → API keys → Create key.
# See SETUP.md for step-by-step instructions with screenshots of where to click.
#
# NEVER commit your .env file. It is listed in .gitignore for that reason.

ANTHROPIC_API_KEY=sk-ant-api03-replace-this-with-your-real-key


# ---- Optional settings (safe defaults; uncomment only to change) ----

# Model used for classification. claude-sonnet-5 is the balanced default;
# claude-opus-5 is the strongest and costs more per run.
# ANTHROPIC_MODEL=claude-sonnet-5

# How many characteristics to classify at the same time. Raise it if your
# account's rate limits allow, lower it if you hit 429 errors.
# MAX_PARALLEL_CLASSIFICATIONS=8

# Seconds to wait for a single model response before giving up.
# ANTHROPIC_TIMEOUT=180

# Classify one characteristic alone first so the rest read from Claude's
# prompt cache. Saves roughly 90% of input cost on a full batch. Set to 0 to disable.
# WARM_PROMPT_CACHE=1

# Local port for the web app.
# PORT=7860
